FROM ubuntu:22.04

# Install necessary packages and Chinese support
RUN apt-get update && apt-get install -y \
    openjdk-11-jdk \
    maven \
    fonts-wqy-microhei \
    fonts-wqy-zenhei \
    language-pack-zh-hans \
    && rm -rf /var/lib/apt/lists/*

# Set Chinese locale
ENV LANG zh_CN.UTF-8

# Set working directory
WORKDIR /workspace

# Copy the project files
COPY pom.xml .
COPY src src/ 

# Build the project
RUN mvn clean package

# Copy and extract fuzz targets
COPY fuzz-targets.tar.gz .
RUN tar xf fuzz-targets.tar.gz && rm fuzz-targets.tar.gz

# Copy and extract results
COPY fuzz-results.tar.gz .
RUN tar xf fuzz-results.tar.gz && rm fuzz-results.tar.gz

# Set default command to bash
CMD ["/bin/bash"]
